# Copy to .env in the same directory before running docker compose.
# .env is gitignored; never commit real secrets.

# 32-byte key, base64-encoded. Generate with:
#   openssl rand -base64 32
NANGO_ENCRYPTION_KEY=

# Strong random password for Nango's internal Postgres. Generate with:
#   openssl rand -hex 24
NANGO_DB_PASSWORD=

# Public URL where providers reach Nango's webhook ingress. Set this to the
# Cloudflare Tunnel hostname you create for Nango (e.g. https://nango.appleap.ai).
NANGO_SERVER_URL=https://nango.appleap.ai
